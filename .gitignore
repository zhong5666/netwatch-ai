# 本地真实配置（含真实内网 IP / 中转地址），只提交 config.example.yaml
config.yaml

# 巡检状态文件（自动生成）
.state.yaml
**/.state.yaml

# 历史库（自动生成）
.history.db
**/.history.db

# Python 缓存 / 虚拟环境 / 测试产物
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# 日志与密钥
*.log
.env

# 本地备份
*.bak

# 演示脚本中间产物（demo/refresh_demo.py 的 raw stdout，重跑即生成）
demo/_new.txt

# HTML 报告的默认输出（含真实内网 IP；只提交 demo/sample_report.html）
/report.html

# 本机脚本（含本机取 key / 路径逻辑），不进公开仓库
*.local.py

# 本地交接笔记（不进公开仓库）
*.local.md

# IDE
.idea/
.vscode/
